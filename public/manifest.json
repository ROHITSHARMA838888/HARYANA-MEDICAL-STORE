{
  "id": "/",
  "name": "Haryana Medical Store — Pharmacy POS & Inventory",
  "short_name": "HaryanaMed",
  "description": "Offline-first Pharmacy POS, FEFO Inventory, OCR Purchase & GST Billing PWA for Haryana Medical Store, Dhoha, Firozpur Jhirka.",
  "lang": "en-IN",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "background_color": "#022c22",
  "theme_color": "#15803d",
  "orientation": "any",
  "categories": [
    "medical",
    "business",
    "finance",
    "productivity"
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "edge_side_panel": {
    "preferred_width": 420
  },
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-wide.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Haryana Medical Store POS Billing & FEFO Inventory Dashboard"
    },
    {
      "src": "/screenshot-narrow.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Haryana Medical Store Mobile Pharmacy POS & Splash View"
    }
  ],
  "shortcuts": [
    {
      "name": "POS Billing Counter",
      "short_name": "POS Billing",
      "description": "Open FEFO POS Billing & GST Invoice Counter",
      "url": "/?tab=Sales&shortcut=1",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Medicines & Inventory",
      "short_name": "Inventory",
      "description": "Manage medicine stock, batches, expiry dates & GST slabs",
      "url": "/?tab=Inventory&shortcut=1",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Purchases & OCR Scanner",
      "short_name": "Purchases",
      "description": "Record supplier purchase invoices and scan bills via OCR",
      "url": "/?tab=Purchases&shortcut=1",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Data Restoration Center",
      "short_name": "Restore Data",
      "description": "Recover deleted medicines, sales bills, suppliers & customers",
      "url": "/?tab=DataRestore&shortcut=1",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/?action=import-backup",
      "accept": {
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+haryanamed",
      "url": "/?lookup=%s"
    }
  ]
}
